# MASTER2-A1 Environment Variables Template
# Copy to .env and fill in your values
# NEVER commit .env to Git!

# ==========================================
# FreeLLMAPI Configuration
# ==========================================
# Get from: https://github.com/<FREE_LLM_API_REPO> (TBD - need exact URL)
FREE_LLM_API_KEY=your_freellmapi_key_here
FREE_LLM_API_BASE_URL=https://api.freellm.example.com/v1  # Update with actual endpoint
FREE_LLM_API_MODEL=auto  # Or specific model ID

# ==========================================
# Alternative LLM Providers (fallbacks)
# ==========================================
# OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_API_BASE=https://api.openai.com/v1

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Local LLM (Ollama)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b

# ==========================================
# Data Access (ALSAT-2B / Substitute)
# ==========================================
# ASAL / CNES / ESA credentials if applicable
# ALSAT_DATA_USERNAME=
# ALSAT_DATA_PASSWORD=
# ALSAT_DATA_URL=

# Sentinel Hub (if using Sentinel-2 as substitute)
# SENTINEL_HUB_CLIENT_ID=
# SENTINEL_HUB_CLIENT_SECRET=

# ==========================================
# Experiment Tracking
# ==========================================
# Weights & Biases
# WANDB_API_KEY=
# WANDB_PROJECT=master2-a1
# WANDB_ENTITY=your_username

# MLflow
# MLFLOW_TRACKING_URI=http://localhost:5000

# ==========================================
# Compute / Cloud (for training)
# ==========================================
# RunPod / Lambda Labs / Vast.ai
# RUNPOD_API_KEY=
# LAMBDA_API_KEY=

# Google Colab (manual, no env var needed)

# ==========================================
# Python / PyTorch
# ==========================================
PYTHONPATH=./src
TORCH_DETERMINISTIC=1
CUBLAS_WORKSPACE_CONFIG=:4096:8

# ==========================================
# OpenCode
# ==========================================
# OPENCODE_API_KEY=  # If using OpenCode cloud